SUPABASE_URL=https://fkhychihxpregusklggo.supabase.co
# Server-only Supabase secret key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Shared dashboard password. Keep all these variables server-only.
DASHBOARD_PASSWORD=
# Random secret of at least 32 characters.
SESSION_SECRET=


# Insight generation (npm run insights). Defaults to local Ollama; override for OpenAI.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Optional: model endpoint for outreach drafts only (npm run drafts). Defaults to local Ollama.
# Example for OpenRouter: base URL https://openrouter.ai/api/v1, a key from openrouter.ai/keys, and a model id from openrouter.ai/models.
DRAFTS_LLM_BASE_URL=
DRAFTS_LLM_API_KEY=
DRAFTS_LLM_MODEL=
