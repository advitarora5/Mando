SUPABASE_URL=https://fkhychihxpregusklggo.supabase.co
# Server-only Supabase secret key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Shared dashboard password. Keep all these variables server-only.
DASHBOARD_PASSWORD=
# Random secret of at least 32 characters.
SESSION_SECRET=


# Insight generation (npm run insights). Defaults to local Ollama; override for OpenAI.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Ingestion pipeline. Caps, thresholds and scoring scope live in the pipeline_settings table, not here.
# Scheduled runs (GitHub Actions secrets) use an API model through the same OpenAI-compatible interface:
#   OpenAI: PIPELINE_LLM_BASE_URL=https://api.openai.com/v1
#   Gemini: PIPELINE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local testing only): PIPELINE_LLM_BASE_URL=http://localhost:11434/v1
PIPELINE_LLM_BASE_URL=
PIPELINE_LLM_MODEL=
PIPELINE_LLM_API_KEY=
# Contact address sent in the User-Agent of every collector request.
PIPELINE_CONTACT=
# Import button only: fine-grained GitHub token limited to this repository with Actions read/write.
# Set in Vercel environment settings only; never in GitHub secrets or committed files.
GITHUB_DISPATCH_TOKEN=
