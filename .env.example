SUPABASE_URL=https://fkhychihxpregusklggo.supabase.co
# Server-only Supabase secret key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Shared dashboard password. Keep all these variables server-only.
DASHBOARD_PASSWORD=
# Random secret of at least 32 characters.
SESSION_SECRET=


# Insight generation (npm run insights). Defaults to local Ollama; override for OpenAI.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Ingestion pipeline (npm run pipeline). Put these in .env.pipeline.local (gitignored). See docs/ingestion-runbook.md.
# Caps, thresholds and scoring scope live in the pipeline_settings table, not here.
# Database: deliberately NOT SUPABASE_URL, which points at production in .env.local. Local: npx supabase start.
PIPELINE_SUPABASE_URL=http://127.0.0.1:54321
# Server-only service-role/secret key of that local or test database.
PIPELINE_SUPABASE_KEY=
# Required only for a non-local test project: its project ref, after approval. Production is never a pipeline target.
PIPELINE_ALLOW_REMOTE=
# Model: ollama (default, local, free) | openai | gemini | none. Paid models also need PIPELINE_ALLOW_PAID_LLM=1.
PIPELINE_LLM=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
PIPELINE_ALLOW_PAID_LLM=
PIPELINE_LLM_BUDGET_USD=0
OPENAI_API_KEY=
GEMINI_API_KEY=
# treg: TREG_TOKEN (a per-org agent token) in CI; locally the signed-in treg CLI is used when this is empty.
TREG_TOKEN=
# Session cap for paid treg calls (USD). --max-spend can lower it per run, never raise it.
TREG_BUDGET_USD=0.50
# Contact address sent in the User-Agent of every collector request. SEC requires one (it answers 403 without).
# Optional: model endpoint for outreach drafts only (npm run drafts). Defaults to local Ollama.
# Example for OpenRouter: base URL https://openrouter.ai/api/v1, a key from openrouter.ai/keys, and a model id from openrouter.ai/models.
DRAFTS_LLM_BASE_URL=
DRAFTS_LLM_API_KEY=
DRAFTS_LLM_MODEL=

# Ingestion pipeline. Caps, thresholds and scoring scope live in the pipeline_settings table, not here.
# Scheduled runs (GitHub Actions secrets) use an API model through the same OpenAI-compatible interface:
#   OpenAI: PIPELINE_LLM_BASE_URL=https://api.openai.com/v1
#   Gemini: PIPELINE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local testing only): PIPELINE_LLM_BASE_URL=http://localhost:11434/v1
PIPELINE_LLM_BASE_URL=
PIPELINE_LLM_MODEL=
PIPELINE_LLM_API_KEY=
# Contact address sent in the User-Agent of every collector request.
PIPELINE_CONTACT=
# Optional: a local copy of https://www.sec.gov/files/company_tickers.json, used only when PIPELINE_CONTACT is empty.
PIPELINE_SEC_FILE=
# Import button only: fine-grained GitHub token limited to this repository with Actions read/write.
# Set in Vercel environment settings only; never in GitHub secrets or committed files.
GITHUB_DISPATCH_TOKEN=
